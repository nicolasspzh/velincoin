{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--browser",
        "chromium",
        "--executable-path",
        "/opt/pw-browsers/chromium",
        "--output-dir",
        "/tmp/playwright-mcp"
      ]
    }
  }
}
