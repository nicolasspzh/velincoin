/* Velincoin wallet theme. Colors match the website: near-black surfaces,
   white type, violet as the only accent (or the light version of it).
   @name@ stands for a color of the dark or light theme; the values are in
   src/qt/velincointheme.cpp. */

QMainWindow, QDialog { background: @window@; }

QToolTip {
    background: @raised@; color: @text@;
    border: 1px solid @tooltip-border@; border-radius: 8px; padding: 6px 8px;
}

/* ---------- menus ---------- */
QMenuBar { background: @window@; border-bottom: 1px solid @raised@; padding: 2px 6px; }
QMenuBar::item { background: transparent; padding: 6px 10px; border-radius: 6px; }
QMenuBar::item:selected { background: @hover@; }
QMenu { background: @input@; border: 1px solid @border@; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 7px 28px 7px 14px; border-radius: 6px; }
QMenu::item:selected { background: @accent@; color: @on-accent@; }
QMenu::item:disabled { color: @text-disabled@; }
QMenu::separator { height: 1px; background: @border@; margin: 6px 8px; }

/* ---------- sidebar ---------- */
QToolBar#appToolBar {
    background: @sidebar@; border: none; border-right: 1px solid @sidebar-border@;
    padding: 20px 14px 16px 14px; spacing: 3px;
}
QToolBar#appToolBar QToolButton {
    color: @sidebar-text@; background: transparent; border: none; border-radius: 10px;
    padding: 10px 12px; min-width: 166px; font-size: 10.5pt; font-weight: 500;
}
QToolBar#appToolBar QToolButton:hover { background: @sidebar-hover@; color: @text@; }
QToolBar#appToolBar QToolButton:checked { background: @selected@; color: @text-strong@; }
QWidget#sidebarHeader { background: transparent; }
QLabel#sidebarBrand { color: @text-strong@; font-size: 15pt; font-weight: 700; }
QLabel#sidebarNetwork {
    color: @sidebar-text@; background: @pressed@; border: 1px solid @badge-border@; border-radius: 9px;
    padding: 3px 9px; font-size: 8.5pt; font-weight: 600;
}
QLabel#sidebarNetwork[test="true"] { color: @pending@; border-color: @warning-border@; background: @warning@; }
QLabel#sidebarSection { color: @text-faint@; font-size: 8.5pt; font-weight: 600; padding: 0 2px 2px 2px; }

/* ---------- inputs ---------- */
QLineEdit, QAbstractSpinBox, QComboBox, QPlainTextEdit, QTextEdit, QDateTimeEdit {
    background: @input@; color: @text@;
    border: 1px solid @border@; border-radius: 9px; padding: 6px 10px;
    selection-background-color: @accent@; selection-color: @on-accent@;
}
QLineEdit:hover, QAbstractSpinBox:hover, QComboBox:hover, QPlainTextEdit:hover, QTextEdit:hover { border-color: @border-hover@; }
QLineEdit:focus, QAbstractSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: @accent@; }
QLineEdit:disabled, QAbstractSpinBox:disabled, QComboBox:disabled { color: @text-disabled@; background: @base@; border-color: @hover@; }
QLineEdit:read-only { background: @base@; }
QTextEdit#messagesWidget, QTextEdit#outputText, QTextBrowser { background: @base@; }

QComboBox { padding-right: 28px; }
QComboBox::drop-down { border: none; width: 26px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url(@icon-chevron-down@); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: @input@; border: 1px solid @border@; border-radius: 8px; padding: 4px;
    selection-background-color: @accent@; selection-color: @on-accent@; outline: 0;
}

QAbstractSpinBox { padding-right: 24px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border; width: 20px; border: none; background: transparent;
}
QAbstractSpinBox::up-button { subcontrol-position: top right; margin-top: 3px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; margin-bottom: 3px; }
QAbstractSpinBox::up-arrow { image: url(@icon-chevron-up@); width: 9px; height: 9px; }
QAbstractSpinBox::down-arrow { image: url(@icon-chevron-down@); width: 9px; height: 9px; }
QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::down-arrow:disabled { image: none; }

/* ---------- buttons ---------- */
QPushButton {
    background: @button@; color: @text@;
    border: 1px solid @control-border@; border-radius: 9px; padding: 7px 16px; min-height: 18px;
}
QPushButton:hover { background: @button-hover@; border-color: @control-border-hover@; }
QPushButton:pressed { background: @pressed@; }
QPushButton:checked { background: @selected@; border-color: @selected-border@; }
QPushButton:disabled { color: @text-disabled@; background: @disabled@; border-color: @disabled-border@; }
QPushButton[primary="true"] { background: @primary@; color: @primary-text@; border: 1px solid @primary@; font-weight: 600; }
QPushButton[primary="true"]:hover { background: @primary-hover@; border-color: @primary-hover@; }
QPushButton[primary="true"]:pressed { background: @primary-pressed@; }
QPushButton[primary="true"]:disabled { background: @control-border@; color: @text-faint@; border-color: @control-border@; }
QPushButton[link="true"] { background: transparent; border: none; color: @link@; padding: 4px 6px; font-weight: 500; }
QPushButton[link="true"]:hover { color: @link-hover@; }
QPushButton:flat { background: transparent; border: none; }

QToolButton { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 4px; }
QToolButton:hover { background: @hover@; border-color: @border@; }
QToolButton:pressed { background: @pressed@; }

/* ---------- tables and lists ---------- */
QTableView, QTreeView, QListView {
    background: @base@; alternate-background-color: @input@;
    border: 1px solid @border-soft@; border-radius: 12px;
    gridline-color: @base@; outline: 0;
    selection-background-color: @row-selected@; selection-color: @text-strong@;
}
QTableView::item, QTreeView::item { padding: 4px 6px; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background: @base@; color: @text-label@; border: none; border-bottom: 1px solid @border-soft@;
    padding: 8px 10px; font-weight: 500;
}
QHeaderView::section:hover { color: @text@; }
QTableCornerButton::section { background: @base@; border: none; }

/* ---------- scroll bars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 3px 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px 3px; }
QScrollBar::handle:vertical { background: @control-border@; border-radius: 3px; min-height: 32px; }
QScrollBar::handle:horizontal { background: @control-border@; border-radius: 3px; min-width: 32px; }
QScrollBar::handle:hover { background: @strong-border@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QScrollArea { background: transparent; border: none; }
QWidget#scrollAreaWidgetContents, QWidget#scrollAreaWidgetContents_2 { background: transparent; }

/* ---------- tabs, groups, frames ---------- */
QTabWidget::pane { border: 1px solid @border-soft@; border-radius: 12px; background: @base@; top: -1px; }
QTabBar::tab { background: transparent; color: @text-dim@; border: none; border-radius: 8px; padding: 7px 14px; margin: 4px 2px; }
QTabBar::tab:selected { background: @selected@; color: @text-strong@; }
QTabBar::tab:hover:!selected { color: @text@; }
QGroupBox { border: 1px solid @border-soft@; border-radius: 12px; margin-top: 16px; padding: 14px 12px 12px 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: @text-dim@; }
QFrame[card="true"] { background: @card@; border: 1px solid @card-border@; border-radius: 16px; }
QFrame[divider="true"] { background: @card-border@; border: none; max-height: 1px; min-height: 1px; }

/* ---------- status bar and progress ---------- */
QStatusBar { background: @sidebar@; border-top: 1px solid @sidebar-border@; color: @text-dim@; }
QStatusBar::item { border: none; }
QProgressBar {
    background: @raised@; border: none; border-radius: 6px; color: @text@;
    text-align: center; min-height: 12px; max-height: 14px;
}
QProgressBar::chunk { background: @accent@; border-radius: 6px; }

/* ---------- overview page ---------- */
QLabel#pageTitle { color: @text-strong@; font-size: 19pt; font-weight: 600; }
QLabel#labelTotalText, QLabel#labelBalanceText, QLabel#labelPendingText, QLabel#labelImmatureText {
    color: @text-label@; font-size: 9.5pt; font-weight: 500;
}
QLabel#labelTotal { color: @text-strong@; font-size: 30pt; font-weight: 600; }
QToolButton#privacyButton { padding: 6px; border-radius: 10px; }
QLabel#chartTitle { color: @text-label@; font-size: 9.5pt; font-weight: 500; }
QPushButton#chartRange { background: transparent; border: 1px solid transparent; border-radius: 7px; padding: 2px 9px; color: @text-label@; font-size: 9pt; }
QPushButton#chartRange:hover { color: @text@; background: @raised@; }
QPushButton#chartRange:checked { color: @text-strong@; background: @selected@; border-color: @selected-border@; }
QLabel#labelTotalDemo { color: @text-dim@; font-size: 10.5pt; }
QLabel#labelBalanceDemo, QLabel#labelUnconfirmedDemo { color: @text-dim@; font-size: 9pt; }
QLabel#labelBalance, QLabel#labelUnconfirmed, QLabel#labelImmature { color: @text@; font-size: 11.5pt; font-weight: 600; }
QLabel#label_4 { color: @text-strong@; font-size: 11.5pt; font-weight: 600; }
QLabel#labelNoTransactions { color: @text-faint@; padding: 28px 8px; }
QListView#listTransactions { background: transparent; border: none; }
QFrame#connectionHint { background: @warning@; border: 1px solid @warning-border@; border-radius: 12px; }
QFrame#connectionHint QLabel { color: @warning-text@; }
QFrame#backupHint { background: @info@; border: 1px solid @info-border@; border-radius: 12px; }
QFrame#backupHint QLabel { color: @info-text@; }
QLabel#labelAlerts, QLabel#label_alerts {
    background: @alert@; color: @warning-text@; border: 1px solid @warning-border@; border-radius: 10px; padding: 9px 12px;
}

/* ---------- mining page ---------- */
QLabel#miningText { color: @text-dim@; }
QLabel#miningLabel { color: @text-label@; font-size: 9.5pt; font-weight: 500; }
QLabel#miningValue { color: @text@; font-weight: 600; }
QLabel#miningSection { color: @text-strong@; font-size: 11.5pt; font-weight: 600; }
QLabel#miningError { color: @negative@; }

/* ---------- other pages ---------- */
QWidget#welcomePage { background: transparent; }
QLabel#welcomeTitle { color: @text-strong@; font-size: 22pt; font-weight: 600; }
QLabel#welcomeText { color: @text-dim@; font-size: 11pt; }
QLabel#label_tx_hint, QLabel#label_receive_hint { color: @text-dim@; }
QFrame#frameFee, QFrame#frameCoinControl, QFrame#SendCoins, QFrame#SendCoins_UnauthenticatedPaymentRequest {
    background: @card@; border: 1px solid @card-border@; border-radius: 14px;
}
QWidget#contentWidget { background: @input@; border: 1px solid @border@; border-radius: 16px; }
ReceiveCoinsDialog QFrame#frame2, ReceiveCoinsDialog QFrame#frame {
    background: @card@; border: 1px solid @card-border@; border-radius: 14px;
}
SendCoinsDialog QPushButton#sendButton, ReceiveCoinsDialog QPushButton#receiveButton {
    background: @primary@; color: @primary-text@; border: 1px solid @primary@; font-weight: 600; padding: 7px 20px;
}
SendCoinsDialog QPushButton#sendButton:hover, ReceiveCoinsDialog QPushButton#receiveButton:hover { background: @primary-hover@; }
SendCoinsDialog QPushButton#sendButton:disabled, ReceiveCoinsDialog QPushButton#receiveButton:disabled {
    background: @control-border@; color: @text-faint@; border-color: @control-border@;
}

/* ---------- check boxes and radio buttons ---------- */
QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px; background: @input@; border: 1px solid @strong-border@;
}
QCheckBox::indicator { border-radius: 5px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: @accent@; }
QCheckBox::indicator:checked { background: @accent@; border-color: @accent@; image: url(:/icons/check); }
QRadioButton::indicator:checked { background: @input@; border: 5px solid @accent@; width: 8px; height: 8px; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: @base@; border-color: @check-disabled-border@; }

/* ---------- send page ---------- */
SendCoinsEntry { background: @card@; border: 1px solid @card-border@; border-radius: 14px; }
