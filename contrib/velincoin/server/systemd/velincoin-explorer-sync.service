# Keeps the block explorer on the website (velincoin.vercel.app/explorer) up to
# date with the test network, every 20 minutes. Run by install.sh when a GitHub
# token is stored in /etc/velincoin/github-token.txt.
[Unit]
Description=Velincoin explorer on the website (test network, every 20 minutes)
After=velincoind-test.service network-online.target
Wants=velincoind-test.service network-online.target

[Service]
User=velincoin
Group=velincoin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/velincoin/explorer/explorer_sync.py --chain testnet4 --datadir /var/lib/velincoin --db /var/lib/velincoin/explorer-website-testnet4.sqlite --token-file /etc/velincoin/github-token.txt --interval 1200
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
