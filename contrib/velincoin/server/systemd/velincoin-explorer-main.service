# Live block explorer for the main network on port 8080, run by install.sh.
[Unit]
Description=Velincoin block explorer (main network, port 8080)
After=velincoind-main.service
Wants=velincoind-main.service

[Service]
User=velincoin
Group=velincoin
ExecStart=/usr/bin/python3 /opt/velincoin/explorer/explorer.py --chain main --datadir /var/lib/velincoin --db /var/lib/velincoin/explorer-main.sqlite --bind 0.0.0.0 --port 8080
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
